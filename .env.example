# ==============================================================================
# Dr Agenda Núcleos — Variables de Entorno de Ejemplo (Valores Ficticios)
# ==============================================================================
# Copie este archivo a `.env` o `.dev.vars` para desarrollo local.
# NUNCA suba claves reales ni `.env` / `.dev.vars` al repositorio Git.

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# URL pública de la aplicación (usada para construir enlaces de reserva y gestión)
PUBLIC_APP_URL=http://localhost:5173

# Conexión a Supabase (Proyecto Remoto o Supabase CLI Local)
SUPABASE_URL=https://ejemplo-proyecto-ficticio.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ficticio_anon_key_no_real
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ficticio_service_role_no_exponer_en_frontend

# Conexión directa/pooler PostgreSQL de Supabase (para transacciones atómicas y RLS)
# En desarrollo local con el contenedor de prueba: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:ficticio_password_no_real@db.ejemplo-proyecto-ficticio.supabase.co:5432/postgres

# Secreto para firmar tokens de sesión y verificación de servidor (mínimo 32 caracteres)
APP_JWT_SECRET=secreto_ficticio_de_ejemplo_cambiar_en_entorno_real_32_chars

# Evolution API para WhatsApp individual por especialista (Docker propio en whatsapp.dragendas.com)
EVOLUTION_API_URL=https://whatsapp.dragendas.com
EVOLUTION_API_KEY=DrAgendas_WA_ClaveSecreta_2026_EjemploFicticio

# Integraciones adicionales opcionales
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=ficticio_phone_id
WHATSAPP_ACCESS_TOKEN=ficticio_whatsapp_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ficticio_verify_token

TRANSACTIONAL_EMAIL_ENABLED=false
RESEND_API_KEY=re_ficticio_api_key
