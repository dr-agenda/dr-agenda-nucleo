{
  "name": "dr-agenda-nucleos",
  "version": "0.1.0",
  "private": true,
  "description": "Dr Agenda Núcleos — PWA Multiagenda médica para núcleos de consultorios (Cloudflare Workers + Supabase PostgreSQL + React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/dev-server.ts",
    "dev:vite": "vite",
    "build": "tsc -b && vite build && esbuild src/worker.ts --bundle --outfile=dist/_worker.js --format=esm --target=es2022 --platform=node --alias:os=node:os --alias:fs=node:fs --alias:net=node:net --alias:tls=node:tls --alias:crypto=node:crypto --alias:stream=node:stream --alias:perf_hooks=node:perf_hooks",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "hono": "^4.7.4",
    "lucide-react": "^0.479.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@hono/node-server": "^1.13.8",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wrangler": "^4.1.0"
  }
}
